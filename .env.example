# KanMind Backend - Umgebungsvariablen (Beispiel)
# Kopiere diese Datei zu .env und passe die Werte an

# Django Secret Key (in Produktion durch sicheren Schluessel ersetzen)
SECRET_KEY=your-secret-key-here

# Debug Modus (in Produktion auf False setzen)
DEBUG=True

# Erlaubte Hosts (kommagetrennt)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - Erlaubte Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# JWT Token Lebensdauer
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
